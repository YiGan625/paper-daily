    {
      "id": "mechanical_fault_diagnosis",
      "name": "机械设备故障诊断",
      "description": "关注机械设备状态监测与故障诊断，重点包括往复式压缩机、活塞压缩机、旋转机械、轴承、电机、齿轮箱等设备的振动信号、应变信号、压力信号、电流信号分析，以及故障特征提取、异常检测、诊断模型和剩余寿命预测。不关注通用视觉模型、自然语言处理模型、机器人动作模型或大语言模型压缩量化论文。",
      "keywords": [
        "mechanical fault diagnosis",
        "machinery fault diagnosis",
        "condition monitoring",
        "predictive maintenance",
        "prognostics and health management",
        "PHM",
        "bearing fault diagnosis",
        "gearbox fault diagnosis",
        "motor fault diagnosis",
        "rotating machinery fault diagnosis",
        "reciprocating machinery fault diagnosis",
        "compressor fault diagnosis",
        "reciprocating compressor fault diagnosis",
        "piston compressor fault diagnosis",
        "compressor valve fault diagnosis",
        "vibration signal analysis",
        "strain signal analysis",
        "pressure signal analysis",
        "motor current signature analysis",
        "sensor signal processing",
        "fault feature extraction",
        "time frequency analysis",
        "wavelet transform",
        "anomaly detection",
        "remaining useful life prediction"
      ]
    },
    {
      "id": "fault_diagnosis_decision_support",
      "name": "故障诊断智能辅助",
      "description": "关注用于机械设备故障诊断的智能辅助方法，包括诊断知识库、检索增强诊断、故障原因推理、实验数据分析、诊断报告生成、人机协同诊断和维修决策支持。该方向必须与传感器信号、机械设备、工业状态监测或故障诊断直接相关。",
      "keywords": [
        "fault diagnosis decision support",
        "knowledge based fault diagnosis",
        "retrieval augmented fault diagnosis",
        "RAG for fault diagnosis",
        "explainable fault diagnosis",
